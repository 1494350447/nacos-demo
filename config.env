# ============================================================
#  nacos-demo 运行配置
#
#  本项目只包含 Nacos 客户端，不包含也不启动 Nacos 服务端。
#  Nacos 服务端是外部前提，需要你自行准备好并保持运行。
#
#  · 改完直接重新执行 ./start-all.sh 即可，不需要重新构建
#  · 所有项都可以用环境变量临时覆盖，例如：
#        DEMO_PORT=9000 ./start-all.sh
#        PROVIDER_PORTS="9082 9083 9084" ./start-all.sh
# ============================================================

# ---------------- Nacos 服务端（外部依赖，指向你已有的 Nacos 即可） ----------------
NACOS_SERVER_ADDR="${NACOS_SERVER_ADDR:-127.0.0.1:8848}"
NACOS_NAMESPACE="${NACOS_NAMESPACE:-public}"
NACOS_USERNAME="${NACOS_USERNAME:-nacos}"
NACOS_PASSWORD="${NACOS_PASSWORD:-nacos}"

# Nacos 控制台端口，仅用于启动完成后打印提示
NACOS_CONSOLE_PORT="${NACOS_CONSOLE_PORT:-8081}"

# ---------------- 应用端口 ----------------
# demo（消费者）监听端口
DEMO_PORT="${DEMO_PORT:-8080}"

# provider 实例端口列表 —— 想开几个实例就往这里加端口，用空格分隔
PROVIDER_PORTS="${PROVIDER_PORTS:-8082 8083}"

# ---------------- JDK ----------------
JAVA_HOME="${JAVA_HOME:-$HOME/.local/lib/jdk}"
